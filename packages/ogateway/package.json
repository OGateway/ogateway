{
  "name": "ogateway",
  "version": "0.1.1",
  "description": "Drop-in React component and hook for collecting mobile money payments through OGateway.",
  "license": "MIT",
  "author": "OGateway",
  "keywords": [
    "ogateway",
    "payments",
    "mobile-money",
    "momo",
    "ghana",
    "react",
    "checkout"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/style.css --minify && node ./scripts/strip-layers.mjs ./dist/style.css",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
